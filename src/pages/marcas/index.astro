---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { 
  Award, 
  ShieldCheck, 
  AlertTriangle, 
  FileCheck2, 
  CheckCircle2, 
  XCircle, 
  ArrowRight, 
  Search, 
  ShieldAlert, 
  Info,
  Beaker,
  Sparkles
} from 'lucide-react';

const comparativasFormas = [
  {
    nutriente: 'Magnesio',
    formaOptima: 'Bisglicinato o L-Treonato',
    absorcionOptima: '30% - 50% (Cruza barrera hematoencefálica)',
    formaEvitar: 'Óxido de Magnesio',
    absorcionEvitar: '4% - 10% (Causa diarrea, nula penetración cerebral)',
    motivo: 'El óxido es el ingrediente más barato de la industria. Su biodisponibilidad es casi nula y actúa principalmente como laxante osmótico, no como soporte neural.'
  },
  {
    nutriente: 'Colina (Acetilcolina)',
    formaOptima: 'Citicolina (CDP-Colina) o Alfa-GPC',
    absorcionOptima: 'Cruza activamente la BHE y eleva uridina/ACh',
    formaEvitar: 'Bitartrato de Colina',
    absorcionEvitar: 'Metabolizada masivamente a TMAO en el intestino',
    motivo: 'El bitartrato no cruza eficazmente al cerebro y bacterias intestinales lo degradan a trimetilamina (TMAO), asociado a inflamación cardiovascular.'
  },
  {
    nutriente: 'Curcumina (Neuroinflamación)',
    formaOptima: 'Extracto con Piperina o Complejo Fitosomado',
    absorcionOptima: '+2.000% de biodisponibilidad plasmática',
    formaEvitar: 'Polvo de cúrcuma crudo no formulado',
    absorcionEvitar: '< 1% de absorción plasmática',
    motivo: 'La curcumina pura es rápidamente glucuronizada y eliminada por el hígado antes de llegar a la circulación cerebral salvo que se combine con piperina o lípidos.'
  },
  {
    nutriente: 'Bacopa Monnieri',
    formaOptima: 'Extracto estandarizado (55% bacósidos)',
    absorcionOptima: 'Fracciones bioactivas A y B cuantificadas',
    formaEvitar: 'Polvo de planta entera sin estandarizar',
    absorcionEvitar: 'Concentración variable e indetectable de bacósidos',
    motivo: 'Tomar raíz seca molida no garantiza ninguna dosis terapéutica de bacósidos y puede acumular metales pesados si el suelo de cultivo no fue analizado.'
  }
];

const patentes = [
  { nombre: 'Cognizin® (Kyowa Hakko)', principio: 'Citicolina bio-idéntica', pureza: '99.5%+', ventaja: 'Proceso de fermentación natural patentado con más de 10 ensayos clínicos controlados sobre memoria de trabajo y foco.' },
  { nombre: 'AlphaSize® (Chemi Nutra)', principio: 'L-Alfa Glicerilfosforilcolina', pureza: '50% - 99%', ventaja: 'Estabilizado molecularmente contra la higroscopicidad (degradación por humedad ambiente).' },
  { nombre: 'Synapsa® & Bacognize®', principio: 'Bacopa Monnieri estandarizada', pureza: '45% - 55% bacósidos', ventaja: 'Extractos sometidos a ensayos clínicos doble ciego para memoria y velocidad de procesamiento de información.' },
  { nombre: 'KSM-66® (Ixoreal)', principio: 'Withania somnifera (Ashwagandha)', pureza: '5% withanólidos', ventaja: 'Extracción acuosa de espectro completo exclusivamente a partir de la raíz (sin hojas, donde abunda la withaferina A citotóxica).' },
];
---

<BaseLayout
  title="Criterios de Calidad, Pureza y Detección de Fraudes | NeuroAtlas"
  description="Guía independiente y científica para evaluar suplementos: formas químicas de alta absorción vs formas inútiles, sellos de laboratorio y detección de estafas."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- 1. HERO -->
    <header class="relative rounded-biotech border border-surface-bright bg-surface-low p-6 sm:p-10 space-y-5 overflow-hidden">
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/40 text-xs font-mono font-bold text-amber-400">
          <Award className="w-3.5 h-3.5 text-amber-400" />
          EDUCACIÓN AL CONSUMIDOR INDEPENDIENTE
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-surface-bright text-xs font-mono text-text-muted">
          <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
          CERO PATROCINIOS
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-surface-bright text-xs font-mono text-text-muted">
          <Beaker className="w-3.5 h-3.5 text-cyan-400" />
          AUDITORÍA ANALÍTICA
        </span>
      </div>

      <div class="space-y-3 max-w-3xl">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight leading-tight">
          Criterios de Calidad: <span class="text-amber-400">Cómo Leer la Letra Pequeña</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          La industria de los suplementos no está sometida a la misma regulación que los fármacos. No te recomendamos marcas comerciales ni recibimos comisiones: te enseñamos la química real para que sepas qué compuestos absorbe tu organismo y qué productos son puro desperdicio económico.
        </p>
      </div>

      <!-- DISCLAIMER TRANSPARENTE -->
      <div class="mt-4 p-4 rounded-xl border border-amber-500/30 bg-amber-500/5 flex items-start gap-3 text-xs text-amber-200/90 leading-relaxed">
        <Info className="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
        <div>
          <strong class="text-amber-400 font-semibold block mb-0.5">Independencia Editorial y Científica:</strong>
          NeuroAtlas no vende suplementos, no acepta comisiones por venta ni tiene acuerdos con fabricantes. Los estándares que aquí se muestran provienen de farmacopeas oficiales (USP, Ph. Eur.), análisis de terceros (ConsumerLab, Labdoor) y ensayos clínicos publicados.
        </div>
      </div>
    </header>

    <!-- 2. COMPARATIVA DE FORMAS QUÍMICAS: QUÉ SIRVE VS QUÉ EVITAR -->
    <section class="space-y-6">
      <div class="border-b border-surface-bright pb-4">
        <h2 class="text-2xl font-bold text-text-primary flex items-center gap-2">
          <span>🧬 Formas de Alta Absorción vs Relleno Inútil</span>
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary mt-1">
          La misma etiqueta puede prometer "Magnesio" o "Colina", pero la molécula que acompaña al nutriente define si cruza al cerebro o termina en el inodoro.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {comparativasFormas.map((item) => (
          <div class="rounded-biotech border border-surface-bright bg-surface p-6 space-y-4 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-surface-bright pb-2">
                <span class="text-base font-bold text-text-primary font-mono">{item.nutriente}</span>
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-lowest text-amber-400 border border-amber-500/30">
                  Criterio Bioquímico
                </span>
              </div>

              <!-- Lo que debes buscar -->
              <div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 space-y-1">
                <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-400">
                  <CheckCircle2 className="w-3.5 h-3.5 shrink-0" />
                  <span>Qué buscar: {item.formaOptima}</span>
                </div>
                <div class="text-[11px] text-text-secondary pl-5">
                  {item.absorcionOptima}
                </div>
              </div>

              <!-- Lo que debes evitar -->
              <div class="p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 space-y-1">
                <div class="flex items-center gap-1.5 text-xs font-bold text-rose-400">
                  <XCircle className="w-3.5 h-3.5 shrink-0" />
                  <span>Qué evitar: {item.formaEvitar}</span>
                </div>
                <div class="text-[11px] text-text-secondary pl-5">
                  {item.absorcionEvitar}
                </div>
              </div>

              <p class="text-xs text-text-secondary leading-relaxed pt-1">
                {item.motivo}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. LAS 4 REGLAS DE ORO PARA NO SER ENGAÑADO -->
    <section class="rounded-biotech border border-surface-bright bg-surface-low p-6 sm:p-8 space-y-6">
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs font-bold uppercase tracking-wider">
          <ShieldAlert className="w-4 h-4" />
          <span>Banderas Rojas del Marketing</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
          Cómo Detectar Estafas y Productos de Baja Calidad
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
          Antes de pulsar "comprar", verifica estos 4 puntos críticos en la etiqueta o ficha técnica del producto:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-surface border border-surface-bright space-y-2">
          <strong class="text-text-primary block font-mono text-xs text-amber-400">
            1. Huir de las "Mezclas Propietarias" (Proprietary Blends)
          </strong>
          <p class="text-text-secondary leading-relaxed">
            Si la etiqueta dice <em>"Fórmula Cerebral Secreta: 800 mg"</em> y luego lista 10 ingredientes sin poner cuántos miligramos hay de cada uno, el fabricante está ocultando que el 95% es el ingrediente barato y apenas hay trazas del caro. Exige siempre dosis desglosadas por compuesto.
          </p>
          <a href="/conceptos/estafas-suplementos" class="text-primary hover:underline inline-flex items-center gap-1 pt-1 font-mono text-[11px]">
            Leer monografía sobre estafas comunes →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-surface border border-surface-bright space-y-2">
          <strong class="text-text-primary block font-mono text-xs text-amber-400">
            2. Desconfiar de Afirmaciones Milagrosas
          </strong>
          <p class="text-text-secondary leading-relaxed">
            Cualquier marca que prometa <em>"Aumenta tu IQ 20 puntos"</em>, <em>"Cura la niebla mental en 24h"</em> o <em>"Reemplaza tu medicación para el TDAH"</em> está violando la ley y usando pseudociencia agresiva. La neurobiología produce mejoras graduales del 5% al 15%, no milagros de la noche a la mañana.
          </p>
          <a href="/conceptos/marketing-enganoso" class="text-primary hover:underline inline-flex items-center gap-1 pt-1 font-mono text-[11px]">
            Ver cómo desmontar el marketing engañoso →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-surface border border-surface-bright space-y-2">
          <strong class="text-text-primary block font-mono text-xs text-amber-400">
            3. Exigir Sellos de Laboratorio Independiente (CoA)
          </strong>
          <p class="text-text-secondary leading-relaxed">
            Las mejores marcas someten sus lotes a laboratorios externos e independientes (NSF Certified for Sport, USP, Informed Choice o certificados de análisis CoA por lote) para garantizar que el producto contiene exactamente lo que declara y está libre de metales pesados (plomo, mercurio) o contaminantes microbiológicos.
          </p>
          <a href="/conceptos/evaluar-suplementos" class="text-primary hover:underline inline-flex items-center gap-1 pt-1 font-mono text-[11px]">
            Guía de 6 pasos para evaluar un suplemento →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-surface border border-surface-bright space-y-2">
          <strong class="text-text-primary block font-mono text-xs text-amber-400">
            4. El Precio Ridículamente Bajo es Sospechoso
          </strong>
          <p class="text-text-secondary leading-relaxed">
            La síntesis química pura y la extracción botánica estandarizada tienen costes industriales inevitables. Un bote de 120 cápsulas de Bacopa o Citicolina por 6€ suele indicar que el principio activo está infradosificado o que la materia prima no pasó controles de pureza.
          </p>
          <a href="/conceptos/marcas-economicas" class="text-primary hover:underline inline-flex items-center gap-1 pt-1 font-mono text-[11px]">
            Marcas con buena relación calidad-precio real →
          </a>
        </div>
      </div>
    </section>

    <!-- 4. PATENTES Y MATERIAS PRIMAS ESTANDARIZADAS DE REFERENCIA -->
    <section class="space-y-4">
      <div class="border-b border-surface-bright pb-3">
        <h2 class="text-xl font-bold text-text-primary flex items-center gap-2">
          <span>🏆 Materias Primas Patentadas (Gold Standard Clínico)</span>
        </h2>
        <p class="text-xs text-text-secondary mt-0.5">
          Muchos fabricantes compran principios activos producidos bajo patente por laboratorios farmacéuticos que han financiado los ensayos clínicos originales:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {patentes.map((pat) => (
          <div class="rounded-biotech border border-surface-bright bg-surface p-5 space-y-2">
            <div class="flex justify-between items-start">
              <h3 class="text-sm font-bold text-text-primary">{pat.nombre}</h3>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-lowest text-primary border border-primary/20">{pat.pureza}</span>
            </div>
            <div class="text-xs font-mono text-amber-400">{pat.principio}</div>
            <p class="text-xs text-text-secondary leading-relaxed pt-1">{pat.ventaja}</p>
          </div>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>
