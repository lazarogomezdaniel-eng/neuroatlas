---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sustancias, getSustanciaBySlug, getCategoriaBySlug } from '../../data/index-models';
import AdBanner from '../../components/monetization/AdBanner.astro';
import { ArrowLeft, Activity, ShieldCheck, CheckCircle2, ShieldAlert, BookOpen, Scale } from 'lucide-react';

export function getStaticPaths() {
  return sustancias.map((s) => ({
    params: { slug: s.slug },
    props: { sustancia: s },
  }));
}

const { sustancia: s } = Astro.props;
const categoria = getCategoriaBySlug(s.categoria);

// Schema.org MedicalSubstance para Google Rich Snippets
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'MedicalSubstance',
  name: s.nombre,
  description: s.mecanismo,
  category: s.categoria,
  activeIngredient: s.nombre,
  indication: s.beneficios.map((b) => ({ '@type': 'MedicalIndication', name: b.nombre })),
  contraindication: s.contraindicaciones.map((c) => ({ '@type': 'MedicalContraindication', name: c })),
  study: s.estudios.map((st) => ({
    '@type': 'MedicalStudy',
    name: st.titulo,
    datePublished: st.anio.toString(),
    description: st.resultado,
  })),
};
---

<BaseLayout
  title={`${s.nombre}: Dosis, Farmacocinética y Evidencia Científica | NeuroAtlas`}
  description={`Monografía médica de ${s.nombre} (${s.nombre_cientifico}). Farmacocinética, mecanismo de acción, sinergias y evidencia clínica.`}
>
  <!-- Inyección de Schema JSON-LD de Google -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <a
      href="/enciclopedia"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-text-muted hover:text-primary transition-colors"
    >
      <ArrowLeft className="w-4 h-4" />
      <span>Volver a la Enciclopedia</span>
    </a>

    <!-- Hero de Ficha -->
    <div class="rounded-biotech border border-surface-bright bg-surface-low p-6 md:p-8 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a
          href={`/categorias/${s.categoria}`}
          class="text-xs font-mono font-bold uppercase tracking-wider hover:underline"
          style={{ color: categoria?.color || '#22d3ee' }}
        >
          {categoria?.nombre || s.categoria}
        </a>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono border border-emerald-500/40 bg-emerald-500/10 text-emerald-400">
            Evidencia {s.nivel_evidencia}
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono border border-surface-bright bg-surface-container text-text-muted">
            Riesgo {s.nivel_riesgo}
          </span>
        </div>
      </div>

      <div>
        <h1 class="text-2xl md:text-4xl font-extrabold text-text-primary tracking-tight">
          {s.nombre}
        </h1>
        <div class="text-xs font-mono text-text-muted italic mt-1">
          {s.nombre_cientifico}
        </div>
      </div>

      <div class="flex flex-wrap gap-1.5 pt-2">
        {s.neurotransmisores.map((nt) => (
          <span class="px-2.5 py-0.5 rounded bg-surface-container text-xs font-mono text-secondary border border-secondary/20">
            {nt}
          </span>
        ))}
        {s.regiones_cerebrales.map((reg) => (
          <span class="px-2.5 py-0.5 rounded bg-surface-lowest text-xs font-mono text-primary border border-primary/20">
            {reg}
          </span>
        ))}
      </div>
    </div>

    <!-- Anuncio In-Article -->
    <AdBanner slotId="substance-top" format="horizontal" />

    <!-- Mecanismo -->
    <section class="rounded-biotech border border-surface-bright bg-surface p-6 space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
        <Activity className="w-4 h-4 text-primary" />
        <h2>Mecanismo de Acción & Bioquímica Sináptica</h2>
      </div>
      <p class="text-xs md:text-sm text-text-secondary leading-relaxed">
        {s.mecanismo}
      </p>
      {s.uso_tradicional && (
        <div class="mt-4 p-3 rounded bg-surface-lowest border border-surface-bright/50 text-xs text-text-muted italic">
          <strong>Uso Tradicional & Etnobotánica:</strong> {s.uso_tradicional}
        </div>
      )}
    </section>

    <!-- Beneficios con Evidencia -->
    <section class="rounded-biotech border border-surface-bright bg-surface-low p-6 space-y-4">
      <h2 class="text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
        Beneficios Cognitivos Validados
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {s.beneficios.map((b) => (
          <div class="p-3 rounded bg-surface border border-surface-bright flex justify-between items-center text-xs">
            <span class="font-semibold text-text-primary">{b.nombre}</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-surface-container text-primary border border-primary/20">
              {b.evidencia}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Dosis y Farmacocinética -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <section class="rounded-biotech border border-surface-bright bg-surface p-6 space-y-3">
        <h2 class="text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
          Posología Recomendada
        </h2>
        <div class="space-y-2 text-xs font-mono">
          <div>
            <span class="text-text-muted block text-[10px]">DOSIS TÍPICA:</span>
            <span class="text-text-primary font-bold">{s.dosis.tipica}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px]">MOMENTO DE TOMA:</span>
            <span class="text-text-primary">{s.dosis.timing}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px]">FORMAS HABITUALES:</span>
            <span class="text-text-secondary">{s.dosis.formas.join(', ')}</span>
          </div>
        </div>
      </section>

      <section class="rounded-biotech border border-surface-bright bg-surface p-6 space-y-3">
        <h2 class="text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
          Farmacocinética
        </h2>
        <div class="space-y-2 text-xs font-mono">
          <div>
            <span class="text-text-muted block text-[10px]">BIODISPONIBILIDAD:</span>
            <span class="text-text-primary">{s.farmacocinetica.biodisponibilidad}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px]">VIDA MEDIA:</span>
            <span class="text-text-primary">{s.farmacocinetica.vida_media}</span>
          </div>
          <div>
            <span class="text-text-muted block text-[10px]">CRUZA BARRERA HEMATOENCEFÁLICA:</span>
            <span class="text-emerald-400 font-bold">{s.farmacocinetica.cruza_bhe ? 'SÍ (Confirmado)' : 'No'}</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Sinergias & Interacciones -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <section class="rounded-biotech border border-emerald-500/20 bg-emerald-500/5 p-6 space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
          <CheckCircle2 className="w-4 h-4" />
          <h2>Sinergias Recomendadas</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          {s.sinergias.map((syn) => (
            <span class="px-2.5 py-1 rounded bg-surface border border-emerald-500/30 text-emerald-300 text-xs font-mono">
              + {syn}
            </span>
          ))}
        </div>
      </section>

      <section class="rounded-biotech border border-rose-500/20 bg-rose-500/5 p-6 space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-rose-400 uppercase tracking-wider">
          <ShieldAlert className="w-4 h-4" />
          <h2>Interacciones & Precauciones</h2>
        </div>
        <div class="space-y-2">
          {s.interacciones.map((inter) => (
            <div class="text-xs bg-surface p-2.5 rounded border border-rose-500/20 space-y-0.5">
              <div class="flex justify-between font-bold text-text-primary">
                <span>{inter.sustancia}</span>
                <span class="font-mono text-rose-400 uppercase text-[10px]">Gravedad: {inter.gravedad}</span>
              </div>
              <p class="text-[11px] text-text-secondary">{inter.descripcion}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Estado Legal -->
    <section class="rounded-biotech border border-surface-bright bg-surface p-6 space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
        <Scale className="w-4 h-4 text-primary" />
        <h2>Estatus Regulatorio y Legal</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-3 rounded bg-surface-lowest border border-surface-bright">
          <span class="text-text-muted block text-[10px]">ESPAÑA (AESAN)</span>
          <span class="text-text-primary">{s.estado_legal.espana}</span>
        </div>
        <div class="p-3 rounded bg-surface-lowest border border-surface-bright">
          <span class="text-text-muted block text-[10px]">UNIÓN EUROPEA</span>
          <span class="text-text-primary">{s.estado_legal.europa}</span>
        </div>
        <div class="p-3 rounded bg-surface-lowest border border-surface-bright">
          <span class="text-text-muted block text-[10px]">ESTADOS UNIDOS (FDA)</span>
          <span class="text-text-primary">{s.estado_legal.eeuu}</span>
        </div>
      </div>
    </section>

    <!-- Estudios Científicos -->
    <section class="rounded-biotech border border-surface-bright bg-surface-low p-6 space-y-4">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-text-muted uppercase tracking-wider">
        <BookOpen className="w-4 h-4 text-primary" />
        <h2>Ensayos Clínicos & Bibliografía</h2>
      </div>
      <div class="space-y-3">
        {s.estudios.map((st) => (
          <article class="p-4 rounded bg-surface border border-surface-bright text-xs space-y-1">
            <div class="flex justify-between items-start gap-4">
              <h3 class="font-bold text-text-primary text-sm">{st.titulo}</h3>
              <span class="font-mono text-text-muted">{st.anio}</span>
            </div>
            <div class="text-[11px] font-mono text-secondary">{st.tipo}</div>
            <p class="text-text-secondary leading-relaxed pt-1">{st.resultado}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
