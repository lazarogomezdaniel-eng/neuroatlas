---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../../components/monetization/AdBanner.astro';
import { 
  Brain, 
  Clock, 
  Layers, 
  Award, 
  BookOpen, 
  ArrowRight, 
  Compass, 
  Dna, 
  Activity, 
  ShieldAlert, 
  Sparkles,
  Zap,
  Flame,
  CheckCircle2,
  ChevronRight
} from 'lucide-react';
---

<BaseLayout
  title="Módulo I: Fundamentos Biológicos de la Neuro-Optimización | NeuroAtlas"
  description="La base científica obligatoria antes de tomar cualquier nootrópico. 41 monografías sobre anatomía, neuroquímica, genética, hormonas e inmunología cerebral."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- 1. HERO -->
    <header class="relative rounded-biotech border border-surface-bright bg-surface-low p-6 sm:p-10 overflow-hidden space-y-6">
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-72 h-72 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/40 text-xs font-mono font-bold text-primary shadow-cyan-glow">
          <Brain className="w-3.5 h-3.5" />
          MÓDULO I · NIVEL FUNDACIONAL
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-surface-bright text-xs font-mono text-text-muted">
          <Layers className="w-3.5 h-3.5 text-primary" />
          41 CONCEPTOS
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-surface-bright text-xs font-mono text-text-muted">
          <Award className="w-3.5 h-3.5 text-secondary" />
          6 SECCIONES
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-surface-bright text-xs font-mono text-text-muted">
          <Clock className="w-3.5 h-3.5 text-emerald-400" />
          4-6 HORAS
        </span>
      </div>

      <div class="space-y-3 max-w-3xl">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight leading-tight">
          Módulo I: Fundamentos Biológicos de la Neuro-Optimización
        </h1>
        <p class="text-base sm:text-xl text-primary font-medium">
          La base científica obligatoria antes de tomar cualquier nootrópico
        </p>
        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed pt-2">
          Comprende la anatomía, neuroquímica, genética, hormonas e inmunología del cerebro. 41 monografías que explican exactamente dónde y cómo actúan los nootrópicos.
        </p>
      </div>
    </header>

    <!-- AdBanner Superior -->
    <AdBanner slotId="modulo-1-top" format="horizontal" />

    <!-- 2. TABLA RESUMEN -->
    <section class="rounded-biotech border border-surface-bright bg-surface p-6 sm:p-8 space-y-6">
      <div class="flex items-center gap-2 text-primary font-mono text-xs font-bold uppercase tracking-wider">
        <Sparkles className="w-4 h-4" />
        <span>Filosofía & Mapa Biológico</span>
      </div>
      <h2 class="text-2xl font-bold text-text-primary">¿Por qué este módulo existe?</h2>
      <p class="text-sm text-text-secondary leading-relaxed">
        El 90% de las personas que empiezan con nootrópicos cometen el mismo error: <strong class="text-text-primary">comprar sustancias sin entender el sistema que están intentando modificar.</strong> Es como intentar tunear un motor sin saber qué es un pistón, una bujía o el aceite.
      </p>
      <p class="text-xs text-text-muted">Este módulo te da el mapa completo del cerebro desde seis ángulos fundamentales:</p>

      <div class="overflow-x-auto border border-surface-bright rounded-biotech">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-surface-lowest text-text-muted font-mono uppercase text-[11px] border-b border-surface-bright">
            <tr>
              <th class="p-3.5">Sección</th>
              <th class="p-3.5">Pregunta que responde</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-bright font-sans text-text-secondary">
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Compass className="w-4 h-4 text-primary shrink-0" /> 1.1 Neuroanatomía
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿Dónde?</strong> ¿Qué regiones cerebrales controlan la memoria, el foco, el miedo y la motivación?</td>
            </tr>
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Zap className="w-4 h-4 text-secondary shrink-0" /> 1.2 Neuroquímica
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿Con qué?</strong> ¿Qué mensajeros químicos usan esas regiones para comunicarse?</td>
            </tr>
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Activity className="w-4 h-4 text-emerald-400 shrink-0" /> 1.3 Neurofisiología
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿Cómo?</strong> ¿Cómo se comunican las neuronas y cómo cambia físicamente el cerebro al aprender?</td>
            </tr>
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Dna className="w-4 h-4 text-amber-400 shrink-0" /> 1.4 Neurogenética
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿Por qué tú?</strong> ¿Por qué la misma sustancia funciona en una persona y en otra no?</td>
            </tr>
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Clock className="w-4 h-4 text-violet-400 shrink-0" /> 1.5 Neuroendocrinología
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿A qué velocidad?</strong> ¿Cómo las hormonas configuran el estado base de tu cerebro?</td>
            </tr>
            <tr class="hover:bg-surface-low/50 transition-colors">
              <td class="p-3.5 font-bold text-text-primary flex items-center gap-2">
                <Flame className="w-4 h-4 text-rose-400 shrink-0" /> 1.6 Neuroinmunología
              </td>
              <td class="p-3.5"><strong class="text-text-primary">¿Qué lo sabotea?</strong> ¿Cómo la inflamación y el intestino destruyen tu cognición sin que lo sepas?</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. MAPA DE CONTENIDO (Tarjetas 1.1 a 1.6) -->
    <section class="space-y-8">
      <div class="border-b border-surface-bright pb-4 flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold text-text-primary flex items-center gap-2">
            <span>🗺️ Mapa de Contenido del Módulo I</span>
          </h2>
          <p class="text-xs sm:text-sm text-text-secondary mt-1">
            41 monografías clínicas clasificadas por sección biológica.
          </p>
        </div>
      </div>

      <!-- Sección 1.1 -->
      <div class="rounded-biotech border border-surface-bright bg-surface p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-surface-bright pb-3">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-primary/20 text-primary font-mono text-xs font-bold">1.1</span>
            <h3 class="text-lg font-bold text-text-primary">Sección 1.1 — Neuroanatomía Funcional</h3>
          </div>
          <span class="text-xs font-mono text-text-muted">8 MONOGRAFÍAS</span>
        </div>
        <p class="text-xs text-text-secondary italic">El mapa físico del cerebro. Entiende qué hace cada región antes de intentar modificarla.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <a href="/conceptos/neuroanatomia-funcional" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <span class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Introducción a la Neuroanatomía</span>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all" />
          </a>
          <a href="/conceptos/corteza-prefrontal" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Corteza Prefrontal</div>
              <div class="text-[11px] text-text-muted italic">La sede del foco, la planificación y el control ejecutivo</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/hipocampo" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Hipocampo</div>
              <div class="text-[11px] text-text-muted italic">El centro de la memoria y la neurogénesis adulta</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/amigdala" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Amígdala</div>
              <div class="text-[11px] text-text-muted italic">El sistema de alarma: miedo, ansiedad y memoria emocional</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/ganglios-basales" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Ganglios Basales y Núcleo Accumbens</div>
              <div class="text-[11px] text-text-muted italic">Hábitos, recompensa y motivación</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/locus-coeruleus" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Locus Coeruleus</div>
              <div class="text-[11px] text-text-muted italic">El interruptor de la alerta (noradrenalina)</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/barrera-hematoencefalica" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Barrera Hematoencefálica</div>
              <div class="text-[11px] text-text-muted italic">El filtro que decide qué llega a tu cerebro</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/sistema-glinfatico" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-primary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-primary transition-colors">Sistema Glinfático</div>
              <div class="text-[11px] text-text-muted italic">El sistema de limpieza nocturna del cerebro</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-primary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
        </div>
      </div>

      <!-- Sección 1.2 -->
      <div class="rounded-biotech border border-surface-bright bg-surface p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-surface-bright pb-3">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-secondary/20 text-secondary font-mono text-xs font-bold">1.2</span>
            <h3 class="text-lg font-bold text-text-primary">Sección 1.2 — Neuroquímica: Los Mensajeros del Cerebro</h3>
          </div>
          <span class="text-xs font-mono text-text-muted">8 MONOGRAFÍAS</span>
        </div>
        <p class="text-xs text-text-secondary italic">Los neurotransmisores son el verdadero objetivo de casi todos los nootrópicos.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <a href="/conceptos/introduccion-neuroquimica" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <span class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Introducción a la Neuroquímica</span>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all" />
          </a>
          <a href="/conceptos/dopamina" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Dopamina</div>
              <div class="text-[11px] text-text-muted italic">Motivación, recompensa y el motor del "querer"</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/acetilcolina" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Acetilcolina</div>
              <div class="text-[11px] text-text-muted italic">El neurotransmisor nootrópico por excelencia: aprendizaje y memoria</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/noradrenalina" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Noradrenalina</div>
              <div class="text-[11px] text-text-muted italic">Alerta, vigilia y respuesta al estrés agudo</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/serotonina" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Serotonina</div>
              <div class="text-[11px] text-text-muted italic">Ánimo, estabilidad emocional y el eje intestino-cerebro</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/gaba" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">GABA</div>
              <div class="text-[11px] text-text-muted italic">El freno natural: calma, ansiedad y sueño</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/glutamato" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Glutamato</div>
              <div class="text-[11px] text-text-muted italic">El acelerador: aprendizaje, plasticidad y excitotoxicidad</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/otros-neuromoduladores" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-secondary/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-secondary transition-colors">Otros Neuromoduladores</div>
              <div class="text-[11px] text-text-muted italic">Histamina, Orexina, Adenosina, Endocannabinoides y BDNF/NGF</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-secondary group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
        </div>
      </div>

      <!-- Sección 1.3 -->
      <div class="rounded-biotech border border-surface-bright bg-surface p-6 sm:p-8 space-y-4">
        <div class="flex items-center justify-between border-b border-surface-bright pb-3">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-xs font-bold">1.3</span>
            <h3 class="text-lg font-bold text-text-primary">Sección 1.3 — Neurofisiología: Cómo se Comunica y se Adapta el Cerebro</h3>
          </div>
          <span class="text-xs font-mono text-text-muted">7 MONOGRAFÍAS</span>
        </div>
        <p class="text-xs text-text-secondary italic">La sinapsis, la plasticidad, la neurogénesis y los mecanismos de daño.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <a href="/conceptos/introduccion-neurofisiologia" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <span class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Introducción a la Neurofisiología</span>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-emerald-400 group-hover:translate-x-1 transition-all" />
          </a>
          <a href="/conceptos/sinapsis-y-senalizacion" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Sinapsis y Señalización Neuronal</div>
              <div class="text-[11px] text-text-muted italic">Los 5 pasos donde actúan los nootrópicos</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-emerald-400 group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/neuroplasticidad" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Neuroplasticidad</div>
              <div class="text-[11px] text-text-muted italic">LTP, LTD y la Ley de Hebb: cómo el cerebro se reescribe</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-emerald-400 group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/neurogenesis-adulta" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Neurogénesis Adulta</div>
              <div class="text-[11px] text-text-muted italic">El nacimiento de nuevas neuronas en el hipocampo</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-emerald-400 group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/sinaptogenesis-y-mielinizacion" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Sinaptogénesis y Mielinización</div>
              <div class="text-[11px] text-text-muted italic">Crear conexiones nuevas y acelerar la transmisión</div>
            </div>
            <ArrowRight className="w-3.5 h-3.5 text-text-muted group-hover:text-emerald-400 group-hover:translate-x-1 transition-all shrink-0 ml-2" />
          </a>
          <a href="/conceptos/neuroinflamacion" class="p-3.5 rounded-biotech border border-surface-bright bg-surface-low hover:border-emerald-500/50 hover:bg-surface-container transition-all group flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-emerald-400 transition-colors">Neuroinflamación</div>
              <div class="text-[11px] text-text-muted italic">El enemigo silencioso: microglía, citocinas y niebla mental</div>
            </div>
