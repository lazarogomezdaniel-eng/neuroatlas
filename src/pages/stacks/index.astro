---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { StackBuilder } from '../../components/features/StackBuilder';
import { 
  Sparkles, 
  Brain, 
  Moon, 
  Heart, 
  Zap, 
  ShieldCheck, 
  ShieldAlert, 
  AlertTriangle, 
  CheckCircle2, 
  Clock, 
  ArrowRight, 
  RotateCcw,
  Info,
  Scale,
  Award,
  Terminal,
  Activity,
  Pill
} from 'lucide-react';

const protocolos = [
  {
    id: 'stack-huberman',
    categoria: 'foco',
    titulo: 'Protocolo Andrew Huberman (Foco & Dopamina)',
    subtitulo: 'Activación dopaminérgica matutina y concentración sostenida sin picos',
    icono: Zap,
    colorTheme: 'cyan',
    colorBadge: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30',
    colorBorder: 'hover:border-cyan-400/50 hover:shadow-cyan-glow',
    specularClass: 'specular-cyan',
    evidencia: 'Grado A (Cafeína + L-Teanina en EEG y tiempo de reacción)',
    circadiano: '🌅 Matutino (90-120 min post-despertar)',
    ingredientes: [
      { nombre: 'L-Tirosina', dosis: '500 mg', timing: 'En ayunas o con café' },
      { nombre: 'L-Teanina', dosis: '100-200 mg', timing: 'Junto con la cafeína' },
      { nombre: 'Alfa-GPC', dosis: '300 mg', timing: 'Antes de bloques de trabajo intenso' }
    ],
    laVerdad: 'La cafeína debe retrasarse 90-120 minutos tras despertar para permitir el aclaramiento natural de adenosina. Si tomas el café de golpe al salir de la cama, tendrás el bajón inevitable a las 14:00.',
    link: '/conceptos/stack-huberman'
  },
  {
    id: 'stack-programador',
    categoria: 'productividad',
    titulo: 'Protocolo para Programadores & Deep Work',
    subtitulo: 'Memoria de trabajo, resolución lógica y resistencia a la fatiga',
    icono: Brain,
    colorTheme: 'emerald',
    colorBadge: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
    colorBorder: 'hover:border-emerald-400/50 hover:shadow-emerald-glow',
    specularClass: 'specular-top',
    evidencia: 'Grado B (Evidencia sólida en memoria operativa)',
    circadiano: '☀️ Media Mañana (Bloques de 90 min)',
    ingredientes: [
      { nombre: 'Cafeína + L-Teanina', dosis: '100 mg + 200 mg', timing: 'Bloque matutino' },
      { nombre: 'Citicolina (CDP-Colina)', dosis: '250 mg', timing: '30 min antes del 2º bloque' },
      { nombre: 'Creatina monohidrato', dosis: '5 g', timing: 'Diariamente con agua' }
    ],
    laVerdad: 'La creatina actúa por saturación mitocondrial celular tras 2-3 semanas; no da energía instantánea. Trabajar más de 6 horas seguidas sin pausas ultradianas de 15 min destruye la calidad del código, tomes lo que tomes.',
    link: '/conceptos/nootropicos-programador'
  },
  {
    id: 'stack-sueno-profundo',
    categoria: 'sueno',
    titulo: 'Stack Sueño Profundo & Ondas Lentas (Delta)',
    subtitulo: 'Latencia reducida, sueño no-REM restaurador y reseteo neural',
    icono: Moon,
    colorTheme: 'indigo',
    colorBadge: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/30',
    colorBorder: 'hover:border-indigo-400/50 hover:shadow-indigo-glow',
    specularClass: 'specular-purple',
    evidencia: 'Grado A (Magnesio & Teanina en arquitectura de sueño)',
    circadiano: '🌙 Noche (45-60 min antes de acostarse)',
    ingredientes: [
      { nombre: 'Bisglicinato de Magnesio', dosis: '200-400 mg', timing: '45-60 min antes de dormir' },
      { nombre: 'L-Teanina', dosis: '100-200 mg', timing: 'Junto con el magnesio' },
      { nombre: 'Apigenina (opcional)', dosis: '50 mg', timing: 'Antes de acostarse' }
    ],
    laVerdad: 'Ningún suplemento supera dormir en una habitación a 18°C, a oscuras total y sin pantallas 1 hora antes. La melatonina a dosis altas (>1-2 mg) genera resaca matutina y desajusta tu producción propia; evítala salvo jet-lag puntual.',
    link: '/conceptos/stack-sueno'
  },
  {
    id: 'stack-memoria-estudiante',
    categoria: 'memoria',
    titulo: 'Stack Memoria & Retención (Estudiantes y Opositores)',
    subtitulo: 'Consolidación sináptica a largo plazo y velocidad de procesamiento',
    icono: Brain,
    colorTheme: 'purple',
    colorBadge: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
    colorBorder: 'hover:border-purple-400/50 hover:shadow-purple-glow',
    specularClass: 'specular-purple',
    evidencia: 'Grado B (Estudios aleatorizados doble ciego en retención)',
    circadiano: '🌅 Mañana (Con desayuno graso)',
    ingredientes: [
      { nombre: 'Bacopa Monnieri (55% bacósidos)', dosis: '300 mg', timing: 'Con comida que contenga grasas' },
      { nombre: 'Citicolina', dosis: '250-500 mg', timing: 'Por la mañana' },
      { nombre: 'Melena de León (extracto)', dosis: '1.000 mg', timing: 'Por la mañana con desayuno' }
    ],
    laVerdad: 'La Bacopa tarda entre 8 y 12 semanas de uso continuo en hacer efecto perceptible. No sirve para tomar la noche antes del examen. Además, si se toma con el estómago vacío produce náuseas.',
    link: '/conceptos/stack-memoria'
  },
  {
    id: 'stack-animo-cortisol',
    categoria: 'calma',
    titulo: 'Stack Ánimo, Calma & Reducción del Estrés',
    subtitulo: 'Regulación del eje HPA, reducción de cortisol y estabilidad emocional',
    icono: Heart,
    colorTheme: 'rose',
    colorBadge: 'bg-rose-500/15 text-rose-300 border-rose-500/30',
    colorBorder: 'hover:border-rose-400/50 hover:shadow-rose-glow',
    specularClass: 'specular-top',
    evidencia: 'Grado A (Omega-3 EPA); Grado B (Ashwagandha KSM-66)',
    circadiano: '🌅 Mañana & 🌆 Tarde',
    ingredientes: [
      { nombre: 'Omega-3 (Alto en EPA)', dosis: '1.000-2.000 mg EPA', timing: 'Con la comida principal' },
      { nombre: 'Ashwagandha (KSM-66)', dosis: '300-600 mg', timing: 'Por la tarde/noche' },
      { nombre: 'Bisglicinato de Magnesio', dosis: '200-400 mg', timing: 'Por la noche' }
    ],
    laVerdad: 'La Ashwagandha reduce el cortisol hasta un 30%, pero DEBE ciclarse (ej. 8 semanas de uso y 2 semanas de descanso) porque el uso ininterrumpido puede inducir apatía emocional (anhedonia) en algunas personas.',
    link: '/conceptos/stack-animo'
  },
  {
    id: 'protocolo-attia',
    categoria: 'longevidad',
    titulo: 'Protocolo Peter Attia (Medicina Preventiva & Longevidad)',
    subtitulo: 'Mantenimiento bioenergético neuronal y prevención del declive cognitivo',
    icono: ShieldCheck,
    colorTheme: 'amber',
    colorBadge: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
    colorBorder: 'hover:border-amber-400/50 hover:shadow-amber-glow',
    specularClass: 'specular-amber',
    evidencia: 'Grado A (Omega-3, Vitamina D3/K2); Grado C (Precursores NAD+)',
    circadiano: '🌅 Con desayuno y ejercicio',
    ingredientes: [
      { nombre: 'Omega-3 (EPA/DHA)', dosis: '2.000-3.000 mg totales', timing: 'Con desayuno' },
      { nombre: 'Vitamina D3 + K2', dosis: '2.000-5.000 UI', timing: 'Con comida rica en grasa' },
      { nombre: 'Magnesio (L-Treonato o Bisglicinato)', dosis: '300-400 mg', timing: 'Noche' }
    ],
    laVerdad: 'Ningún nootrópico ni suplemento previene la neurodegeneración tanto como el ejercicio físico (zona 2 cardiovascular y fuerza muscular) junto a la salud metabólica (HbA1c baja). Los suplementos son solo el 5% superior.',
    link: '/conceptos/stack-attia'
  },
  {
    id: 'stack-tdah-soporte',
    categoria: 'enfoque',
    titulo: 'Soporte Complementario en TDAH (No Farmacológico)',
    subtitulo: 'Apoyo a la síntesis de catecolaminas y modulación de la atención sostenida',
    icono: Zap,
    colorTheme: 'teal',
    colorBadge: 'bg-teal-500/15 text-teal-300 border-teal-500/30',
    colorBorder: 'hover:border-teal-400/50 hover:shadow-teal-glow',
    specularClass: 'specular-top',
    evidencia: 'Grado B (L-Tirosina en agotamiento de catecolaminas)',
    circadiano: '🌅 Mañana en ayunas',
    ingredientes: [
      { nombre: 'L-Tirosina', dosis: '500-1.000 mg', timing: 'En ayunas antes del desayuno' },
      { nombre: 'Fosfatidilserina', dosis: '100-300 mg', timing: 'Con alimentos' },
      { nombre: 'Zinc + Magnesio', dosis: '15 mg + 200 mg', timing: 'Con la cena' }
    ],
    laVerdad: 'Este stack apoya la función ejecutiva, pero NO reemplaza la medicación estimulante prescrita (metilfenidato, lisdexanfetamina) si tienes diagnóstico médico de TDAH. Consulta siempre con tu psiquiatra.',
    link: '/conceptos/nootropicos-tdah'
  },
  {
    id: 'stack-ansiedad-social',
    categoria: 'calma',
    titulo: 'Stack Calma Social & Presentaciones',
    subtitulo: 'Reducción de palpitaciones y temblor sin aturdimiento cognitivo',
    icono: Heart,
    colorTheme: 'rose',
    colorBadge: 'bg-rose-500/15 text-rose-300 border-rose-500/30',
    colorBorder: 'hover:border-rose-400/50 hover:shadow-rose-glow',
    specularClass: 'specular-top',
    evidencia: 'Grado B (L-Teanina y Propanolol natural en estrés agudo)',
    circadiano: '⚡ 45 min antes del evento',
    ingredientes: [
      { nombre: 'L-Teanina', dosis: '200-400 mg', timing: '45 min antes de hablar en público' },
      { nombre: 'Extracto de Melissa (Toronjil)', dosis: '300 mg', timing: 'Junto con la teanina' },
      { nombre: 'Magnesio Taurato', dosis: '200 mg', timing: '1 hora antes' }
    ],
    laVerdad: 'La L-teanina a dosis de 300-400 mg atenúa el pico simpático (corazón acelerado) manteniendo la mente lúcida. No tomes benzodiacepinas para hablar en público porque arruinan la fluidez verbal.',
    link: '/conceptos/nootropicos-ansiedad'
  }
];
---

<BaseLayout
  title="Protocolos Clínicos & Stacks de Nootrópicos | NeuroAtlas"
  description="Combinaciones clínicas probadas con dosis exactas en miligramos, timing circadiano y desmitificación científica rigurosa."
>
  <div class="bg-grid-biotech min-h-screen py-10 px-4 sm:px-6 lg:px-8 space-y-12 max-w-6xl mx-auto">

    <!-- 1. HERO DE ALTA GAMA -->
    <header class="relative rounded-2xl border border-white/[0.08] bg-surface/85 backdrop-blur-xl p-6 sm:p-10 overflow-hidden space-y-6 specular-top shadow-2xl">
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-wrap items-center gap-2.5 relative z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary/15 border border-secondary/40 text-xs font-mono font-bold text-secondary">
          <Sparkles className="w-3.5 h-3.5 text-secondary" />
          PROTOCOLOS CLÍNICOS & STACKS
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-lowest/80 border border-white/10 text-xs font-mono text-text-muted">
          <Award className="w-3.5 h-3.5 text-primary" />
          DOSIS EXACTAS EN MG
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-lowest/80 border border-white/10 text-xs font-mono text-text-muted">
          <Clock className="w-3.5 h-3.5 text-emerald-400" />
          TIMING CIRCADIANO
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-lowest/80 border border-white/10 text-xs font-mono text-text-muted">
          <Scale className="w-3.5 h-3.5 text-amber-400" />
          EVIDENCIA GRADO A/B
        </span>
      </div>

      <div class="space-y-3 max-w-3xl relative z-10">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          El Arte del Stacking: <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-cyan-300 to-secondary">Sinergias Farmacológicas</span>
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Combinaciones probadas por la neurociencia clínica. Dosis exactas en miligramos, momentos óptimos de toma y la verdad sin filtros sobre qué esperar y qué es puro mito comercial.
        </p>
      </div>

      <!-- AVISO DE RESPONSABILIDAD & HONESTIDAD CIENTÍFICA -->
      <div class="p-4 sm:p-5 rounded-xl border border-amber-500/30 bg-amber-500/10 backdrop-blur-md flex items-start gap-3.5 text-xs text-amber-200/90 leading-relaxed relative z-10">
        <AlertTriangle className="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
        <div>
          <strong class="text-amber-400 font-bold block mb-1">Aviso de Responsabilidad & Honestidad Científica:</strong>
          La información aquí expuesta tiene fines estrictamente educativos y de divulgación. Los nootrópicos no sustituyen tratamientos médicos ni hábitos basales (dormir 7-8h, ejercicio y nutrición). Si tomas fármacos (antidepresivos, ansiolíticos, levotiroxina) o estás embarazada, consulta siempre con un médico antes de suplementarte.
        </div>
      </div>
    </header>

    <!-- 2. CATÁLOGO VISUAL DE PROTOCOLOS -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.08] pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/30 text-[10px] font-mono text-primary font-bold uppercase tracking-wider mb-1">
            <Activity className="w-3 h-3" />
            Catálogo Clínico
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            8 Protocolos Listos para Usar
          </h2>
          <p class="text-xs sm:text-sm text-text-secondary mt-1">
            Diseñados con 2 o 3 compuestos con sinergia validada. Menos ingredientes, mayor eficacia y cero saturación enzimática.
          </p>
        </div>
      </div>

      <!-- Grilla de Tarjetas de Stacks -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {protocolos.map((proto) => {
          const Icon = proto.icono;
          return (
            <article class={`group relative rounded-2xl border border-white/[0.08] bg-surface/85 backdrop-blur-xl p-6 sm:p-7 space-y-5 transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-2xl flex flex-col justify-between ${proto.specularClass} ${proto.colorBorder}`}>
              <div class="space-y-4">
                
                {/* Cabecera de la tarjeta */}
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface-lowest border border-white/10 flex items-center justify-center text-primary group-hover:scale-105 transition-transform shadow-sm">
                      <Icon className="w-5 h-5" />
                    </div>
                    <div>
                      <span class={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full border ${proto.colorBadge}`}>
                        {proto.evidencia}
                      </span>
                      <div class="text-[10px] font-mono text-text-muted mt-1 flex items-center gap-1">
                        <Clock className="w-3 h-3 text-primary/70" />
                        <span>{proto.circadiano}</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-white group-hover:text-primary transition-colors leading-snug tracking-tight">
                    {proto.titulo}
                  </h3>
                  <p class="text-xs text-text-secondary mt-1 leading-relaxed">
                    {proto.subtitulo}
                  </p>
                </div>

                <!-- Tabla de ingredientes en miligramos -->
                <div class="space-y-2 pt-1">
                  <div class="text-[10px] font-mono uppercase tracking-wider text-text-muted font-bold flex items-center gap-1.5">
                    <Pill className="w-3 h-3 text-primary/60" />
                    Componentes & Dosis Diaria:
                  </div>
                  <div class="space-y-2">
                    {proto.ingredientes.map((ing) => (
                      <div class="flex items-center justify-between p-2.5 rounded-xl bg-surface-lowest/80 border border-white/[0.06] text-xs">
                        <span class="font-semibold text-white flex items-center gap-2">
                          <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                          {ing.nombre}
                        </span>
                        <div class="flex items-center gap-2 font-mono text-[11px] shrink-0">
                          <span class="text-primary font-bold">{ing.dosis}</span>
                          <span class="text-text-muted text-[10px] hidden sm:inline">({ing.timing})</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- La verdad sin humo -->
                <div class="p-3.5 rounded-xl bg-cyan-500/[0.04] border border-cyan-500/20 text-xs text-text-secondary leading-relaxed space-y-1.5">
                  <div class="flex items-center gap-1.5 font-bold text-xs text-cyan-300">
                    <Info className="w-4 h-4 text-cyan-400 shrink-0" />
                    <span>La verdad científica (sin humo):</span>
                  </div>
                  <p class="text-xs text-slate-300 leading-relaxed font-normal">
                    {proto.laVerdad}
                  </p>
                </div>
              </div>

              <!-- Footer de la tarjeta -->
              <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between mt-auto">
                <a
                  href={proto.link}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-cyan-300 transition-colors group/link active:scale-[0.98]"
                >
                  <span>Ver monografía y estudios completos</span>
                  <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-1" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 3. SECCIÓN DE SEGURIDAD CRÍTICA (ALERTAS ROJAS / ÁMBAR) -->
    <section class="rounded-2xl border border-rose-500/30 bg-gradient-to-br from-rose-500/10 via-rose-500/5 to-transparent p-6 sm:p-8 space-y-6 specular-top shadow-2xl relative overflow-hidden">
      <div class="flex items-center gap-2 text-rose-400 font-mono text-xs font-bold uppercase tracking-wider">
        <ShieldAlert className="w-4 h-4" />
        <span>Zona Crítica de Seguridad Farmacológica</span>
      </div>

      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Combinaciones Prohibidas & Qué Evitar
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary max-w-3xl leading-relaxed">
          La mayoría de personas creen que "lo natural no hace daño". Sin embargo, mezclar suplementos con mecanismos superpuestos puede provocar crisis hipertensivas, colapso de receptores o el potencialmente mortal <strong>síndrome serotoninérgico</strong>.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-5 rounded-xl bg-surface/90 border border-rose-500/30 space-y-2.5 shadow-lg">
          <div class="flex items-center gap-2 text-rose-400 font-bold text-sm">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span>⚠️ Peligro Vital: Síndrome Serotoninérgico</span>
          </div>
          <p class="text-text-secondary leading-relaxed">
            <strong>NUNCA mezcles:</strong> 5-HTP, L-Triptófano o Hierba de San Juan con fármacos antidepresivos (ISRS, IRSN o IMAOs). La acumulación excesiva de serotonina en la hendidura sináptica causa hipertermia, convulsiones y riesgo vital inmediato.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-surface/90 border border-rose-500/30 space-y-2.5 shadow-lg">
          <div class="flex items-center gap-2 text-rose-400 font-bold text-sm">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span>⚠️ Desensibilización & Burnout Dopaminérgico</span>
          </div>
          <p class="text-text-secondary leading-relaxed">
            Tomar L-Tirosina o estimulantes a diario sin pausas agota la enzima tirosina hidroxilasa y causa tolerancia a la baja en receptores D2. Aplica siempre la regla de <strong>5 días ON / 2 días OFF</strong> para mantener la sensibilidad receptiva.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-surface/90 border border-amber-500/30 space-y-2.5 shadow-lg">
          <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span>⚠️ Sedación Paradójica & Conflicto GABA/Glutamato</span>
          </div>
          <p class="text-text-secondary leading-relaxed">
            Combinar múltiples sedantes gabaérgicos (Fenibut + Valeriana + Kava + Alcohol) puede provocar depresión respiratoria severa. Mantén los inductores de calma en 1 solo compuesto por toma.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-surface/90 border border-amber-500/30 space-y-2.5 shadow-lg">
          <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
            <AlertTriangle className="w-4 h-4 shrink-0" />
            <span>⚠️ Interacción con Hormonas Tiroideas</span>
          </div>
          <p class="text-text-secondary leading-relaxed">
            La Ashwagandha estimula la glándula tiroides y puede aumentar los niveles de T3 y T4. Personas con hipertiroidismo o medicadas con Levotiroxina deben evitarla sin supervisión endocrina.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. HERRAMIENTA INTERACTIVA: CONSTRUCTOR DE STACKS PERSONALIZADO -->
    <section class="rounded-2xl border border-white/[0.08] bg-surface/85 backdrop-blur-xl p-6 sm:p-8 space-y-6 specular-top shadow-2xl">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/30 text-[10px] font-mono text-primary font-bold uppercase tracking-wider">
          <Terminal className="w-3 h-3" />
          Herramienta Interactiva
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Diseña tu propio Stack Personalizado
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary">
          Añade sustancias para calcular sinergias, verificar que no haya interacciones de riesgo y exportar tu protocolo en PDF o JSON:
        </p>
      </div>

      <!-- Componente interactivo StackBuilder de React Island -->
      <StackBuilder client:load />
    </section>

    <!-- 5. ENLACES RÁPIDOS Y PIE DE PÁGINA -->
