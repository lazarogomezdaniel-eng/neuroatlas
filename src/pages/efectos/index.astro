---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COGNITIVE_EFFECTS } from '../../data/curriculum-data';
import { Sparkles, ArrowRight, Brain, Zap, ShieldCheck } from 'lucide-react';
---

<BaseLayout
  title="Explorar por Efecto Cognitivo | NeuroAtlas"
  description="Filtrado y exploración farmacológica de nootrópicos según sus 8 objetivos y efectos neurológicos principales."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Hero Header -->
    <div class="rounded-biotech border border-surface-bright bg-surface-low p-6 md:p-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-secondary/10 border border-secondary/30 text-xs font-mono text-secondary font-semibold">
        <Sparkles className="w-3.5 h-3.5" />
        <span>TAXONOMÍA FUNCIONAL · 8 EFECTOS NEUROLÓGICOS</span>
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-text-primary tracking-tight">
        Explorar por Efecto Cognitivo
      </h1>
      <p class="text-xs md:text-sm text-text-secondary max-w-3xl leading-relaxed">
        Selecciona el objetivo cognitivo o estado mental que deseas potenciar. Cada categoría agrupa sustancias validadas clínicamente con sus mecanismos moleculares específicos.
      </p>
    </div>

    <!-- Grid de los 8 Efectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {COGNITIVE_EFFECTS.map((eff) => (
        <a
          href={`/enciclopedia?efecto=${eff.slug}`}
          class="group rounded-biotech border border-surface-bright bg-surface p-5 hover:border-secondary hover:shadow-violet-glow transition-all flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-3xl">{eff.icon}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-surface-low border border-surface-bright text-text-muted group-hover:text-secondary group-hover:border-secondary/40 transition-colors">
                {eff.substanceCount} sustancias
              </span>
            </div>
            <h2 class="text-base font-bold text-text-primary group-hover:text-secondary transition-colors">
              {eff.title}
            </h2>
            <p class="text-xs text-text-secondary leading-relaxed">
              {eff.shortDesc}
            </p>
          </div>

          <div class="pt-3 border-t border-surface-bright/50 flex items-center justify-between text-xs font-mono text-text-muted group-hover:text-secondary transition-colors">
            <span>Ver Fichas</span>
            <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
