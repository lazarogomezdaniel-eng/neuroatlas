---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categorias, sustancias } from '../../data/index-models';
import { FolderTree, ArrowRight, Activity, Brain, Leaf, Zap, ShieldCheck } from 'lucide-react';
---

<BaseLayout
  title="Categorías Farmacológicas de Nootrópicos | NeuroAtlas"
  description="Clasificación de familias nootrópicas: colinérgicos, racetams, adaptógenos, dopaminérgicos y neuroprotectores."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="rounded-biotech border border-surface-bright bg-surface-low p-6 md:p-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-primary/10 border border-primary/30 text-xs font-mono text-primary font-semibold">
        <FolderTree className="w-3.5 h-3.5" />
        <span>TAXONOMÍA BIO-MÉDICA</span>
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-text-primary tracking-tight">
        Familias y Categorías de Nootrópicos
      </h1>
      <p class="text-xs md:text-sm text-text-secondary max-w-3xl leading-relaxed">
        Explora los compuestos agrupados por su perfil neurobiológico principal, vías de síntesis de neurotransmisores y dianas moleculares.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categorias.map((cat) => {
        const count = sustancias.filter((s) => s.categoria === cat.slug).length;

        return (
          <a
            href={`/categorias/${cat.slug}`}
            class="group rounded-biotech border border-surface-bright bg-surface p-6 hover:border-primary/50 hover:shadow-cyan-glow transition-all flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div
                class="w-10 h-10 rounded-biotech flex items-center justify-center border text-sm font-bold font-mono"
                style={{
                  backgroundColor: `${cat.color}15`,
                  borderColor: `${cat.color}40`,
                  color: cat.color,
                }}
              >
                Ψ
              </div>

              <h2 class="text-lg font-bold text-text-primary group-hover:text-primary transition-colors">
                {cat.nombre}
              </h2>
              <p class="text-xs text-text-secondary leading-relaxed line-clamp-3">
                {cat.descripcion}
              </p>
            </div>

            <div class="pt-4 border-t border-surface-bright/50 flex items-center justify-between text-xs font-mono">
              <span class="text-text-muted">{count} compuestos indexados</span>
              <span class="text-primary flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Ver categoría →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</BaseLayout>
